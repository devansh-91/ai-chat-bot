# Copy to .env.local. Leave both empty to run in offline guest mode (no sign-in / sync).
# Local:  npm run db:start  -> use API_URL and ANON_KEY from `npx supabase status`
# Cloud:  Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: default Ollama server for the "local server" model tier
VITE_OLLAMA_URL=http://localhost:11434

# Used only by `supabase start` for local Google sign-in (never exposed to the browser)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
